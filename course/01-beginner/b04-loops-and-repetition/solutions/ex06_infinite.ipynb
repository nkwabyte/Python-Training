   "source": [
    "from __future__ import annotations\n",
    "\n",
    "\n",
    "def count_down(start: int) -> list[int]:\n",
    "    result: list[int] = []\n",
    "    while start > 0:\n",
    "        result.append(start)\n",
    "        start -= 1\n",
    "    return result\n"
   ]
