   "source": [
    "from __future__ import annotations\n",
    "\n",
    "\n",
    "def is_valid_password(password: str) -> bool:\n",
    "    return (\n",
    "        len(password) >= 8\n",
    "        and any(ch.isdigit() for ch in password)\n",
    "        and any(ch.isalpha() for ch in password)\n",
    "        and \" \" not in password\n",
    "    )\n"
   ]
  }
