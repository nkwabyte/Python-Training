    "from __future__ import annotations\n",
    "\n",
    "\n",
    "def ticket_price(age: int, is_weekend: bool) -> int:\n",
    "    if age < 5:\n",
    "        return 0\n",
    "    if age <= 12:\n",
    "        return 8 if is_weekend else 6\n",
    "    if age <= 64:\n",
    "        return 15 if is_weekend else 12\n",
    "    return 7\n"
   ]
