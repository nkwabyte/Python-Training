    "\n",
    "\n",
    "def make_receipt(item: str, quantity: int, unit_price: float) -> str:\n",
    "    total = quantity * unit_price\n",
    "    return f\"{item:<12} {quantity:>3} x {unit_price:>6.2f} = ${total:>7.2f}\"\n"
   ]
